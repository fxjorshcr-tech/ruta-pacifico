# Resend — https://resend.com/api-keys
# IMPORTANT: rotate the key if it was ever shared anywhere public.
RESEND_API_KEY=re_your_api_key_here

# Sender shown to customers. Must use a domain verified in Resend
# (rutapacifico.com — already DKIM/SPF verified).
EMAIL_FROM="Ruta Pacifico <reservations@rutapacifico.com>"

# Sender used ONLY for internal admin notifications (new booking / contact
# alerts), kept distinct from the reservations@ inbox. It does NOT need to
# exist as a mailbox — Resend can send from any address on the verified
# domain. If left blank, the code auto-derives bookings@<EMAIL_FROM domain>.
#
# DELIVERABILITY: if admin notifications stop arriving while customer emails
# still deliver, check Resend -> Emails -> Suppressions FIRST. Resend adds a
# recipient to its suppression list after a single hard bounce and then
# silently skips it on every later send (status "Suppressed" in the Emails
# log). Both admin addresses sat on that list for ~5 months in 2026. Remove
# the address there and re-test. DNS (DMARC/DKIM/SPF, hosted on Vercel) is
# already correct and the reservations@ mailbox is iCloud Mail (iCloud+).
EMAIL_NOTIFICATIONS_FROM="Ruta Pacifico Reservations <bookings@rutapacifico.com>"

# Where new bookings + contact form messages are delivered. Comma-separated.
EMAIL_NOTIFICATIONS_TO=reservations@rutapacifico.com,fxjorshcr@gmail.com

# Optional: address customers see when they hit "reply" on auto-emails.
# Defaults to the first EMAIL_NOTIFICATIONS_TO entry.
EMAIL_REPLY_TO=reservations@rutapacifico.com

# Google Analytics 4 — Measurement ID from
# Admin → Data Streams → Web. Looks like "G-XXXXXXXXXX".
# Leave empty to disable analytics (no scripts will load).
NEXT_PUBLIC_GA_ID=

# Google Search Console — verification code (HTML tag method).
# In Search Console → Add property → URL prefix → "HTML tag",
# copy ONLY the value of the content="..." attribute here.
# Leave empty to skip the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — verification code (meta tag method).
# Bing Webmaster → Add site → "HTML Meta Tag" → copy ONLY the content="..."
# value. Several codes (e.g. two accounts) can be comma-separated. Leave
# empty to skip the tag. (The Google variable above also accepts a
# comma-separated list, one code per Search Console account.)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key — instant indexing for Bing, Copilot, DuckDuckGo, Yandex,
# Naver and Seznam. Any 8–128 char hex/alphanumeric string works; Bing
# Webmaster → IndexNow → "Generate" gives you one. The key is served at
# https://rutapacifico.com/indexnow-key.txt and used by `npm run indexnow`.
INDEXNOW_KEY=

# Google Places API — live star rating and review count of the Google
# Business Profile, shown in the review badges, the Organization JSON-LD and
# llms.txt. Without it the site shows the last known figures from
# src/lib/contact.ts. Google Cloud Console → APIs & Services → enable
# "Places API (New)" → Credentials → API key, restricted to that API only
# (it is used server-side, never sent to the browser). One lookup every 6 h
# stays far inside the free monthly Places allowance.
GOOGLE_PLACES_API_KEY=
# Optional: the profile's Place ID (ChIJ…), skips the text search. Leave
# empty and the profile is found by its CID automatically.
GOOGLE_PLACE_ID=
